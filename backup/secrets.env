# Encrypting password for Duplicati
DUPLICATI_PASSWORD_ENCRYPT=
# Web interface password for Duplicati
DUPLICATI_PASSWORD_WEB=
# Nom d'hôte du serveur de messagerie (par ex. smtp.gmail.com). Le définir active l'e-mail de l'instance
SMTP_HOST=
# Port du serveur de messagerie (par ex. 587). Doit être un entier positif quand SMTP_HOST est défini
SMTP_PORT=
# Sécurité de la connexion : tls, starttls ou none, décrits plus bas. Vaut tls par défaut sur le port 465 et starttls sur tous les autres. Avec toute autre valeur, l'instance refuse de démarrer
SMTP_SECURITY=
# Nom d'utilisateur pour l'authentification SMTP.
SMTP_USER=
# Mot de passe pour l'authentification SMTP. Pour Gmail, utilisez un App Password, pas le mot de passe de votre compte.
SMTP_PASSWORD=
# Adresse de l'expéditeur, seule (noreply@example.com) ou avec un nom (Acme Backups <noreply@example.com>). Sans nom, les destinataires voient Databasus. Si elle n'est pas définie, SMTP_USER est utilisé s'il s'agit d'une adresse e-mail, sinon noreply@ suivi de SMTP_HOST : un nom d'utilisateur comme apikey ne devient donc jamais l'expéditeur. Si la valeur ne peut pas être lue comme une adresse, l'instance refuse de démarrer.
SMTP_FROM=
# Le nom sous lequel l'instance se présente au serveur de messagerie. Par défaut, l'hôte de DATABASUS_URL, ou à défaut le nom de la machine. Doit être un nom d'hôte ou un littéral d'adresse comme [192.0.2.1] ou [IPv6:2001:db8::1], sinon l'instance refuse de démarrer.
SMTP_HELO_NAME=
# Mettez true pour ignorer la vérification du certificat TLS dans les modes tls et starttls. Vaut false par défaut. À réserver aux serveurs avec un certificat auto-signé sur un réseau de confiance : cette option désactive la protection contre les attaques de l'homme du milieu.
SMTP_INSECURE_SKIP_VERIFY=
