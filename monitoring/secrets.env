# Grafana PDC token
GRAFANA_PDC_TOKEN=
# Fail2ban UI OIDC client credentials
FAIL2BAN_UI_OIDC_CLIENT_ID=
# Fail2ban UI OIDC client secret
FAIL2BAN_UI_OIDC_CLIENT_SECRET=
# Session signing secret (openssl rand -hex 32); blank lets the app auto-generate.
FAIL2BAN_UI_OIDC_SESSION_SECRET=
# Shared secret validating Fail2ban's ban/unban callbacks (openssl rand -hex 32); blank lets the app auto-generate and persist it under $JOHNCLOUD_ROOT/fail2ban-ui.
FAIL2BAN_UI_CALLBACK_SECRET=
