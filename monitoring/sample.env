JOHNCLOUD_ROOT=/path/to/root/of/paas/data
HOST=domain.tld
TZ=Etc/UTC
PUBLIC_IP_ADDRESS=
TRAEFIK_NETWORK=traefik-proxy

# Uplink interface Suricata captures on.
SURICATA_UPLINK=eth0
# Also capture the Docker bridge on this subnet (the Traefik/core network) so
# Suricata sees decrypted HTTP + post-NAT flows. Leave empty to capture the
# uplink only (lowest CPU). Matched by subnet, not the churning br-* name.
SURICATA_BRIDGE_SUBNET=192.168.203

# Path on the host to the core stack's Traefik log directory. CrowdSec tails
# access.log from here for HTTP abuse signals. Set this before running
# scripts/install-host-security.sh.
TRAEFIK_LOG_DIR=

GRAFANA_PDC_CLUSTER=
GRAFANA_PDC_GCP_ID=

# Read-only login role on the monitoring database, for query/dashboard consumers
# (e.g. Grafana). configure-monitoring.sh creates it with SELECT on the public
# schema (current and future tables). Password lives in secrets.env.
MONITORING_RO_DB_USER=monitoring_ro
