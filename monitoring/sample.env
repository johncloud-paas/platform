JOHNCLOUD_ROOT=/path/to/root/of/paas/data
HOST=domain.tld
TZ=Etc/UTC
PUBLIC_IP_ADDRESS=
TRAEFIK_NETWORK=traefik-proxy

# Path on the host to the core stack's Traefik log directory. Fail2ban tails
# access.log from here for HTTP abuse signals. Set this before running
# scripts/install-host-security.sh.
TRAEFIK_LOG_DIR=

# Fail2ban tunables (optional — these defaults are applied if left blank).
F2B_BANTIME=1h          # how long a ban lasts
F2B_FINDTIME=10m        # window in which F2B_MAXRETRY failures trigger a ban
F2B_MAXRETRY=5          # failures before an IP is banned
# Extra never-ban space (RFC1918 is added automatically). Space-separated CIDRs,
# e.g. your Tailscale/WireGuard ranges.
F2B_IGNOREIP=

GRAFANA_PDC_CLUSTER=
GRAFANA_PDC_GCP_ID=

# Read-only login role on the monitoring database, for query/dashboard consumers
# (e.g. Grafana). configure-monitoring.sh creates it with SELECT on the public
# schema (current and future tables). Password lives in secrets.env.
MONITORING_RO_DB_USER=monitoring_ro

# How often (seconds) the geoip-sync service re-resolves banned IPs to geo/ASN from
# the GeoLite2 mmdb (maintained by core/geoipupdate) into the geoip_lookup table.
GEOIP_SYNC_INTERVAL=3600
