JOHNCLOUD_ROOT=/path/to/root/of/paas/data
HOST=domain.tld
TZ=Etc/UTC
PUBLIC_IP_ADDRESS=
TRAEFIK_NETWORK=traefik-proxy
# Host dir holding Traefik's JSON access.log (core compose: ./pangolin/traefik/logs).
# Mounted into fluent-bit for TLS analysis — see Traefik-Log-Analysis.md.
TRAEFIK_LOG_DIR=/path/to/root/of/paas/repo/core/pangolin/traefik/logs
# Uplink interface Suricata captures on (Docker bridges auto-discovered).
SURICATA_UPLINK=eth0
GRAFANA_PDC_TOKEN=
GRAFANA_PDC_CLUSTER=
GRAFANA_PDC_GCP_ID=

# fail2ban-ui — web UI for the host Fail2ban ban layer. Runs ROOTLESS in this stack
# and controls the host's rootful Fail2ban via the SSH connector (configured in the
# UI after first start). Internal listen port (Traefik targets it by name).
FAIL2BAN_UI_PORT=8099
# Authentik OIDC. Create the application/provider manually first (slug: fail2ban-ui,
# redirect URI https://fail2ban.<HOST>/auth/callback), then paste the credentials here.
FAIL2BAN_UI_OIDC_PROVIDER=authentik
# Leave ISSUER blank to use the default https://authentik.<HOST>/application/o/fail2ban-ui/
FAIL2BAN_UI_OIDC_ISSUER_URL=
FAIL2BAN_UI_OIDC_CLIENT_ID=
FAIL2BAN_UI_OIDC_CLIENT_SECRET=
# Authentik group(s) granting access (comma-separated). ADMIN = full control,
# SUPPORT = dashboard/event reads plus manual ban/unban. ROLE_CLAIM is "groups".
FAIL2BAN_UI_OIDC_ADMIN_ROLES=
FAIL2BAN_UI_OIDC_SUPPORT_ROLES=
# Session signing secret (openssl rand -hex 32); blank lets the app auto-generate.
FAIL2BAN_UI_OIDC_SESSION_SECRET=

# SSH connector host login. setup_before_up.sh provisions this dedicated user with
# narrow sudo (fail2ban-client + restart) and an /etc/fail2ban ACL so the UI can
# control the host daemon. Blank = don't provision (configure a connector yourself).
FAIL2BAN_UI_SSH_USER=fail2ban-ui
# The UI's SSH public key (it generates a keypair in /config/.ssh on first start and
# shows the public key when you add the server). Paste it here, then re-run startstack
# to authorize it. In the UI add server host=host.docker.internal, port=22, this user.
FAIL2BAN_UI_SSH_PUBKEY=
